# Copy to .env (setup.ps1 does this). .env is git-ignored.

# Optional. Without a key everything works: Roman Urdu is written by the /romanize Claude Code
# skill instead. With a key the app can also do it automatically after transcription.
ANTHROPIC_API_KEY=

# Model used for Roman Urdu. Haiku 5.5 is the lowest-cost current model and is the default. You can also pick
# a model in the app once an API key is set.
ROMANIZE_MODEL=claude-haiku-5-5

# Largest accepted upload in GB.
MAX_UPLOAD_GB=8
